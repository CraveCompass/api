# .env.example
# Copy this file to .env and replace the values with your local setup

# Database Configuration
POSTGRES_USER=crave_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=cravecompass_dev
DATABASE_URL=postgres://crave_user:your_secure_password@localhost:5432/cravecompass_dev
GOOGLE_PLACES_API_KEY=

# Server Configuration
PORT=8080
ENV=development